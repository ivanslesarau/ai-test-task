# Copy to .env and fill in real values. The app refuses to start if any
# required key is missing (constitution: configuration via pydantic-settings).

APP_ENV=development

DATABASE_URL=sqlite+aiosqlite:///./var/app.db

SESSION_COOKIE_NAME=pp_session
SESSION_IDLE_DAYS=7

INVITATION_TTL_HOURS=24

SIGNIN_MAX_ATTEMPTS=10
SIGNIN_WINDOW_MINUTES=15

UPLOAD_DIR=./var/uploads
MAX_UPLOAD_BYTES=5242880

EMAIL_BACKEND=filesystem
EMAIL_OUTBOX_DIR=./var/outbox
# EMAIL_BACKEND=smtp
# SMTP_HOST=                     # required when EMAIL_BACKEND=smtp
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=             # required when EMAIL_BACKEND=smtp; no default
# SMTP_TLS=starttls              # starttls (587) | implicit (465) | none (local dev sink)
# SMTP_TIMEOUT_SECONDS=10

FRONTEND_BASE_URL=http://localhost:5173

# Read only by the `bootstrap-superadmin` CLI command, never by the API.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=change-me-please-12345

# Feature 002: coach invitations, availability, impersonation.
COACH_INVITATION_TTL_DAYS=7    # FR-002: how long a mailed coach invitation stays usable
IMPERSONATION_MAX_MINUTES=60   # FR-046: the ceiling on one Super Admin impersonation session
